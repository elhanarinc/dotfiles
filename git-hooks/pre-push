#!/usr/bin/env bash
#
# pre-push — block a push that would publish a secret.
#
# Scans only the commit range actually being pushed, so it stays fast on large
# histories. Requires gitleaks; if gitleaks is absent the hook warns and allows
# the push rather than blocking work on a missing tool.
#
# Bypass for a single push (use deliberately):  git push --no-verify
#
set -uo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  printf '\033[1;33m[pre-push]\033[0m gitleaks not installed — secret scan skipped\n' >&2
  exit 0
fi

ZERO="0000000000000000000000000000000000000000"
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Deleting a remote ref — nothing to scan
  [[ "$local_sha" == "$ZERO" ]] && continue

  if [[ "$remote_sha" == "$ZERO" ]]; then
    # New branch: scan every commit not already reachable from another remote ref
    log_opts="$local_sha --not --remotes"
  else
    log_opts="$remote_sha..$local_sha"
  fi

  printf '\033[1;34m[pre-push]\033[0m gitleaks: %s\n' "$log_opts" >&2
  if ! gitleaks git --no-banner --redact --log-opts="$log_opts" .; then
    status=1
  fi
done

if [[ $status -ne 0 ]]; then
  cat >&2 <<'MSG'

[pre-push] Push blocked: gitleaks found a potential secret above.
  - False positive? Add a `.gitleaksignore` entry or a `gitleaks:allow` comment.
  - Genuinely need to push anyway? git push --no-verify

MSG
fi

exit $status
