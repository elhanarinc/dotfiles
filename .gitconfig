[include]
    path = ~/.gitconfig.local

[init]
    defaultBranch = master

[color]
    ui = true

[color "branch"]
    current = blue reverse
    local = blue
    remote = red

[color "status"]
    added = yellow
    changed = cyan
    untracked = red

[alias]
    br = branch
    co = checkout
    sw = switch
    new = switch -c
    lg = log -p
    st = status
    cmt = commit
    lol = log --graph --decorate --pretty=oneline --abbrev-commit
    unstage = restore --staged
    nuke = !git reset --hard HEAD && git clean -fd
    update = !git stash && git pull && git stash pop
    addall = add -A
    list = branch -a
    renew = !git remote update --prune && git branch -a
    uncommit = reset --soft HEAD~1
    aliases = config --get-regexp alias
    contributors = shortlog --summary --numbered --no-merges
    dft = difftool --tool=difftastic --no-prompt

[core]
    excludesfile = ~/.gitignore
    pager = delta
    autocrlf = input
    editor = vim

[delta]
    navigate = true
    light = false
    side-by-side = true
    line-numbers = true

[interactive]
    diffFilter = delta --color-only

[pull]
    rebase = false

[fetch]
    prune = true

[push]
    default = current
    autoSetupRemote = true

# Reuse recorded conflict resolutions — solve the same conflict once, not twice
[rerere]
    enabled = true

[diff]
    renames = true
    mnemonicprefix = true

[difftool]
    prompt = false

# Structural (syntax-aware) diff — complements delta, which stays the default pager.
# Usage: git dft            (working tree)
#        git dft HEAD~1     (against a commit)
[difftool "difftastic"]
    cmd = difft "$LOCAL" "$REMOTE"

[merge]
    conflictstyle = zdiff3
