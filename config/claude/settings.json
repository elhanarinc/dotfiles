  "skillOverrides": {
    "agents-sdk": "off",
    "cloudflare": "off",
    "cloudflare-email-service": "off",
    "durable-objects": "off",
    "sandbox-sdk": "off",
    "web-perf": "off",
    "workers-best-practices": "off",
    "wrangler": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/node \"$HOME/Obsidian/brain/bin/scripts/brief.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/node \"$HOME/Obsidian/brain/bin/scripts/nudge.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/node \"$HOME/Obsidian/brain/bin/scripts/capture.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/node \"$HOME/.claude/hooks/tsc-check.mjs\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/node \"$HOME/Obsidian/brain/bin/scripts/reindex-hook.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enableArtifact": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "bash -c 'plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | awk -F/ '\"'\"'{ print $(NF-1) \"\\t\" $(0) }'\"'\"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); exec node \"${plugin_dir}dist/index.js\"'"
  },
  "enabledPlugins": {
    "claude-hud@claude-hud": true,
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "opus",
  "tui": "default",
  "skipWorkflowUsageWarning": true,
  "switchModelsOnFlag": false,
  "autoContinueAtUsageLimit": false,
  "remoteControlAtStartup": false,
  "skipAutoPermissionPrompt": true,
  "cleanupPeriodDays": 180
}
