{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/node \"$HOME/Obsidian/brain/bin/scripts/codex-brief.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/node \"$HOME/Obsidian/brain/bin/scripts/codex-capture.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "(^|__)exec$|apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/node \"$HOME/Obsidian/brain/bin/scripts/codex-reindex-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
