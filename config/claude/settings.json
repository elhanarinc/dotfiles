{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/node \"$HOME/Obsidian/brain/bin/scripts/brief.mjs\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/node \"$HOME/Obsidian/brain/bin/scripts/capture.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/homebrew/bin/node \"$HOME/Obsidian/brain/bin/scripts/reindex-hook.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
