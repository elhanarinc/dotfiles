{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/Obsidian/brain/bin/brief.mjs\" --cwd \"$PWD\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/Obsidian/brain/bin/capture.mjs\" --cwd \"$PWD\" --source codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "(^|__)exec$|apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/Obsidian/brain/bin/reindex.mjs\" --quiet",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
